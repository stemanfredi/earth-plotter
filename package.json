{
  "name": "earth-plotter",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "A map of the world's land and sea in one static page, from open data, with measuring and drawing tools. No build: these scripts are for development only.",
  "author": "Stefano Manfredi",
  "homepage": "https://earthplotter.org",
  "repository": { "type": "git", "url": "git+https://github.com/stemanfredi/earth-plotter.git" },
  "scripts": {
    "test": "node --import ./test/unit/setup.mjs --test \"test/unit/*.test.mjs\"",
    "lint": "eslint .",
    "smoke": "node test/smoke.mjs",
    "draw": "node test/draw.mjs",
    "ui": "node test/ui.mjs",
    "tiles-check": "node test/tiles-check.mjs",
    "perf": "node test/perf.mjs",
    "data-check": "node tools/data-check.mjs",
    "vendor": "node tools/deps.mjs --write",
    "serve": "node test/serve.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "geographiclib-geodesic": "2.2.0",
    "geojson-vt": "4.0.2",
    "globals": "17.13.0",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "6.15.0",
    "playwright-core": "1.64.1",
    "polygon-clipping": "0.15.7",
    "vt-pbf": "3.1.3"
  }
}
